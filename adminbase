{% load static %}
<!doctype html>
<html class="no-js" lang="en">
<head>
    <!-- META DATA -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Induction Motor Fault Detection</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Font / Icons -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:400,600" rel="stylesheet">
    <link rel="stylesheet" href="{% static 'css/font-awesome.min.css' %}">

    <!-- Your CSS files -->
    <link rel="stylesheet" href="{% static 'css/style.css' %}">
    <link rel="stylesheet" href="{% static 'css/responsive.css' %}">

    <style>
        /* Custom Navy Blue Navbar */
        .navbar {
            background-color: #001f4d !important; /* Navy Blue */
            height: 3cm !important;
        }
        body {
            background-color: #f9f9f9;
            font-family: 'Poppins', sans-serif;
            margin: 0;
        }
    </style>
</head>

<body>

<!-- ========== NAVBAR START ========== -->
<nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow">
    <div class="container-fluid">
        <!-- Left: Project Title -->
        <a class="navbar-brand ms-3" href="{% url 'index' %}" style="font-size:26px; font-weight:bold;">
            Python Crypto Investment Manager
        </a>

        <!-- Toggle Button (for small screens) -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
                data-bs-target="#navbarNav" aria-controls="navbarNav" 
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Right: Menu Links -->
        <div class="collapse navbar-collapse justify-content-end me-4" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link active fs-5" href="{% url 'AdminHome' %}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active fs-5" href="{% url 'RegisterUsersView' %}">ViewRegisterUsers</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active fs-5" href="{% url 'logout_view' %}">Logout</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<!-- ========== NAVBAR END ========== -->

<!-- Add spacing below fixed navbar -->
<div style="margin-top:3.5cm;"></div>

<!-- ========== PAGE CONTENT ========== -->
{% block contents %}
{% endblock %}
<!-- ========== PAGE CONTENT END ========== -->

</body>
</html>
